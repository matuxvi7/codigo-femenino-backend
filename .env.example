# ==========================================
# Configuración del servidor Flask
# ==========================================
PORT=5000
FLASK_DEBUG=True
APP_ENV=development
RESET_DEV_DATABASE_ON_STARTUP=false
CORS_ORIGINS=*

# ==========================================
# Configuración de MySQL
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codigo_femenino
# Para Aiven: descarga su CA y configura la ruta absoluta al archivo.
# DB_SSL_REQUIRED=true
# DB_SSL_CA=C:/ruta/a/aiven-ca.pem

# Configuración del pool de conexiones
DB_POOL_MIN_CACHED=2
DB_POOL_MAX_CONNECTIONS=10

# ==========================================
# Cloudinary (imágenes de artículos)
# Obtené estos valores en el dashboard de
# Cloudinary → Settings → API Keys
# ==========================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret